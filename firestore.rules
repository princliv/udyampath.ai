rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function approvedRecruiter() {
      let userData = exists(userPath(request.auth.uid))
        ? get(userPath(request.auth.uid)).data
        : {};
      return signedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true)
        || ('recruiterStatus' in request.auth.token && request.auth.token.recruiterStatus == 'approved')
        || ('recruiterStatus' in userData && userData.recruiterStatus == 'approved')
      );
    }

    // A recruiter account created before this ruleset has no users/{uid} doc.
    // New signups write that doc, so they stay blocked until an admin approves them.
    function legacyRecruiter(uid) {
      return isOwner(uid) && !exists(userPath(uid));
    }

    function catalogWrite() {
      return isAdmin();
    }

    match /Recruiters/{uid}/{contentType}/{docId} {
      allow read: if true;
      allow create: if request.resource.data.recruiterId == uid
        && (approvedRecruiter() && isOwner(uid) || legacyRecruiter(uid));
      allow update, delete: if resource.data.recruiterId == uid
        && request.resource.data.recruiterId == uid
        && (approvedRecruiter() && isOwner(uid) || legacyRecruiter(uid));
    }

    match /Users/{uid}/AppliedJobs/{applicationId} {
      allow read: if isOwner(uid)
        || (signedIn() && resource.data.recruiterId == request.auth.uid);
      allow create: if isOwner(uid)
        && request.resource.data.applicantId == uid;
      allow update, delete: if false;
    }

    match /users/{uid}/{courseTitle}/{scoreId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['role', 'recruiterStatus']);
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'recruiterStatus'])
        );
      allow delete: if false;

      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /courses/{id} {
      allow read: if true;
      allow write: if catalogWrite();
    }

    match /specializations/{id} {
      allow read: if true;
      allow write: if catalogWrite();
    }

    match /cities/{id} {
      allow read: if true;
      allow write: if catalogWrite();
    }

    match /jobs/{id} {
      allow read: if true;
      allow create: if approvedRecruiter()
        && request.resource.data.recruiterId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (
          approvedRecruiter()
          && resource.data.recruiterId == request.auth.uid
          && request.resource.data.recruiterId == request.auth.uid
        );
    }

    match /questionBanks/{courseId}/questions/{id} {
      allow read, write: if false;
    }

    match /enrollments/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.courseId
        && request.resource.data.courseId is string
        && request.resource.data.progressPct is number
        && !request.resource.data.keys().hasAny(['passedFinal', 'certificateId']);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.get('passedFinal', false) == resource.data.get('passedFinal', false)
        && request.resource.data.get('certificateId', '') == resource.data.get('certificateId', '');
      allow delete: if false;
    }

    match /assessmentAttempts/{id} {
      allow read, write: if false;
    }

    match /certificates/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
